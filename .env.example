# Strava API credentials (required)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: Garmin Connect, for wellness data, watch workouts and courses. Easier: leave these
# out and connect Garmin from the app's Garmin page, which keeps only the session, not the password
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# Optional: OpenAI, for the Coach (chat, plans, reviews) and dictation
# OPENAI_API_KEY=

# Optional: Cloudflare Tunnel, for remote access with Docker (see DEPLOY.md).
# Left empty rather than commented out, so docker compose doesn't warn about it
CLOUDFLARE_TUNNEL_TOKEN=

# CORS origins for production (JSON array)
# STRAVA_WEB_CORS_ORIGINS=["https://z2.example.com"]

# CARTO basemap key. Without it cartocdn stamps every map tile with an
# "API KEY REQUIRED" watermark and the frontend falls back to plain OSM.
# Free, no account needed: https://carto.com/basemaps/apikey
# STRAVA_WEB_CARTO_API_KEY=

# Where z2 keeps its data (activities, streams, tokens, calendar.db) and its
# street maps and exports. Default: .strava/ and zone2_workdir/ in the checkout
# STRAVA_WEB_DATA_DIR=
# STRAVA_WEB_WORKDIR=

# Backend log level (DEBUG | INFO | WARNING | ERROR). Default: INFO
# STRAVA_WEB_LOG_LEVEL=INFO

# Auto-sync scheduler: run an incremental sync every N hours in the background.
# 0 disables (default) — manual UI sync still works either way.
# STRAVA_WEB_AUTO_SYNC_HOURS=12

# Optional: Telegram bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
