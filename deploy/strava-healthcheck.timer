[Unit]
Description=Run Strava Intelligence health probe every 15 min

[Timer]
# First run shortly after boot — catches immediate post-reboot breakage.
OnBootSec=2min
# Then every 15 min. Keep this in sync with the Healthchecks.io check's
# "period" (15 min) and "grace" (5 min) — gives ~20 min detection.
OnUnitActiveSec=15min
Unit=strava-healthcheck.service
Persistent=true

[Install]
WantedBy=timers.target
