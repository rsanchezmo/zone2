[Unit]
Description=Strava Intelligence — auto-deploy from prod branch
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# EDIT THESE to match your Pi: the user that owns the repo and its path.
User=pi
Group=pi
WorkingDirectory=/home/pi/strava-intelligence
ExecStart=/home/pi/strava-intelligence/scripts/auto-deploy.sh

# Treat a failed rebuild as a failure so systemd logs it clearly.
# (The old container keeps running — failure here doesn't stop the app.)
TimeoutStartSec=30min

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
