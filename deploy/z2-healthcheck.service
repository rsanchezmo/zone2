[Unit]
Description=z2 health probe (Healthchecks.io dead-man's switch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/z2-healthcheck.env
# EDIT THESE to match your Pi: the user that owns the repo and its path.
User=pi
Group=pi
ExecStart=/home/pi/zone2/scripts/healthcheck.sh

StandardOutput=journal
StandardError=journal
